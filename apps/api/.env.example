# Copy to apps/api/.env. Paste the exact backend-only Dashboard Connect value.
ROADMAP_DB_BACKEND=postgres
ROADMAP_DATABASE_URL=
# Temporary MVP: TLS is required but server certificates are not verified.
# CA paths in ROADMAP_DATABASE_URL and PGSSLROOTCERT are ignored.
ROADMAP_AUTO_SEED_DEV=0
ROADMAP_API_HOST=127.0.0.1
ROADMAP_API_PORT=8000
ROADMAP_APP_ORIGIN=http://localhost:3000
# Only for local HTTP development. Do not enable on Render.
ROADMAP_INSECURE_LOCAL_COOKIE=1
# Optional server-side Himalayas key; anonymous access works without it.
HIMALAYAS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Phase 3: configure real server keys only in Render Environment.
# Keep OFF until approved migrations, backup and private Storage checks pass.
ROADMAP_POSTGRES_DOCUMENTS_ENABLED=0
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=roadmap-documents
SUPABASE_SECRET_KEY=
# Legacy alternative: set SUPABASE_SERVICE_ROLE_KEY instead of SUPABASE_SECRET_KEY.

# Public project key used by the backend to verify bearer tokens with Supabase Auth.
SUPABASE_PUBLISHABLE_KEY=
