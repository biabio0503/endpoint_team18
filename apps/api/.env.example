# Copy to apps/api/.env. Paste the exact backend-only Dashboard Connect value.
ROADMAP_DB_BACKEND=postgres
ROADMAP_DATABASE_URL=
# Temporary MVP: TLS is required but server certificates are not verified.
# CA paths in ROADMAP_DATABASE_URL and PGSSLROOTCERT are ignored.
ROADMAP_AUTO_SEED_DEV=0
ROADMAP_API_HOST=127.0.0.1
ROADMAP_API_PORT=8000
ROADMAP_APP_ORIGIN=http://localhost:3000
# Only for local HTTP development. Do not enable on Render.
ROADMAP_INSECURE_LOCAL_COOKIE=1
# Optional server-side Himalayas key; anonymous access works without it.
HIMALAYAS_API_KEY=
# Contest Korea Basic DEMO v1.1; server only. Never use NEXT_PUBLIC_ or log request URLs.
CONTESTKOREA_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Phase 3: configure real server keys only in Render Environment.
# Keep OFF until approved migrations, backup and private Storage checks pass.
ROADMAP_POSTGRES_DOCUMENTS_ENABLED=0
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=roadmap-documents
SUPABASE_SECRET_KEY=
# Legacy alternative: set SUPABASE_SERVICE_ROLE_KEY instead of SUPABASE_SECRET_KEY.

# Public project key used by the backend to verify bearer tokens with Supabase Auth.
SUPABASE_PUBLISHABLE_KEY=

# Persistent AI guardrails (apply 20261109073304_guest_service_guardrails first).
# Units reserve the worst-case provider attempts, not tokens or billing currency.
# 0 blocks new paid work; reads/reuse and limited guidance remain available.
ROADMAP_AI_COOLDOWN_SECONDS=60
ROADMAP_AI_GUEST_HOURLY_UNITS=60
ROADMAP_AI_GUEST_DAILY_UNITS=120
ROADMAP_AI_USER_HOURLY_UNITS=120
ROADMAP_AI_USER_DAILY_UNITS=360
ROADMAP_AI_GLOBAL_DAILY_UNITS=600

# Opt-in OCR. Apply document_ocr_units and document_ocr_billing_period migrations
# before enabling on PostgreSQL. Keep disabled until separately approved.
# Hard ceilings: 900 units / America/Los_Angeles calendar month (DST-aware), 50 distinct pages or images / document.
ROADMAP_OCR_PROVIDER=none
ROADMAP_OCR_MONTHLY_UNIT_LIMIT=900
ROADMAP_OCR_MAX_PAGES_PER_DOCUMENT=50
# Backend only. Local file-backed ADC is also supported when this is unset.
# Render Secret File example: /etc/secrets/google-vision-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=
